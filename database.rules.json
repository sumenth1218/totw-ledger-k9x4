        "email": { ".validate": "newData.isString() && ((root.child('admins').child(auth.uid).val() === true && newData.val().length === 0) || (newData.val().length > 3 && newData.val().length <= 180 && (root.child('admins').child(auth.uid).val() === true || newData.val() === auth.token.email)))" },
        "role": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "defaultDayRate": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && (root.child('admins').child(auth.uid).val() === true || newData.val() === data.val())" },
        "manual": { ".validate": "newData.isBoolean() && (root.child('admins').child(auth.uid).val() === true || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000 && (root.child('admins').child(auth.uid).val() === true || newData.val() === data.val())" },
        "createdBy": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180 && (root.child('admins').child(auth.uid).val() === true || newData.val() === data.val())" },
        "claimedFrom": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200 && (root.child('admins').child(auth.uid).val() === true || newData.val() === data.val())" },
        "claimedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000 && (root.child('admins').child(auth.uid).val() === true || newData.val() === data.val())" },
        "telegram": { ".validate": "root.child('admins').child(auth.uid).val() === true || newData.val() === data.val()" },
        "$other": { ".validate": false }
      }
    },
    "crewCheckins": {
      "events": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$eventId": {
          ".read": "auth != null && root.child('crewCheckins').child('assignments').child(auth.uid).child($eventId).val() === true",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          "venueGps": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('crewCheckins').child('assignments').child(auth.uid).child($eventId).val() === true && !data.exists()))",
            ".validate": "newData.hasChildren(['lat','lng','setAt','setBy'])",
            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "setAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "setBy": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
            "$other": { ".validate": false }
          },
          "venueLat": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('crewCheckins').child('assignments').child(auth.uid).child($eventId).val() === true && newData.val() === newData.parent().child('venueGps').child('lat').val()))",
            ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
          },
          "venueLng": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('crewCheckins').child('assignments').child(auth.uid).child($eventId).val() === true && newData.val() === newData.parent().child('venueGps').child('lng').val()))",
            ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
          },
          "actualStartAt": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('crewCheckins').child('assignments').child(auth.uid).child($eventId).val() === true && !data.exists()))",
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
          }
        }
      },
      "assignments": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$eventId": {
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
            ".validate": "newData.val() === true"
          }
        }
      },
      "plannedAssignments": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$eventId": {
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
            ".validate": "newData.val() === true"
          }
        }
      },
      "attendance": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$eventId": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid && root.child('crewCheckins').child('assignments').child($uid).child($eventId).val() === true",
            ".write": "auth != null && ((auth.uid === $uid && root.child('crewCheckins').child('assignments').child($uid).child($eventId).val() === true) || root.child('admins').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['updatedAt'])",
            "openedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "confirmedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "checkedInAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "checkedOutAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "checkinLat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "checkinLng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "gpsAccuracy": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "distanceM": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000" },
            "late": { ".validate": "newData.isBoolean()" },
            "lateMinutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
            "cardsBrought": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0" },
            "cardsUsed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0" },
            "cardCustody": { ".validate": "newData.val() === 'handed_over' || newData.val() === 'copying_with_me' || newData.val() === 'handed_to_lead' || newData.val() === 'taking_with_me'" },
            "handedToUid": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
            "handedToName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "handoverAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "copyStatus": { ".validate": "newData.val() === 'with_lead' || newData.val() === 'pending' || newData.val() === 'copied'" },
            "copyDueAt": { ".validate": "newData.isNumber() && newData.val() <= now + 10860000" },
            "copiedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "continuingToNextShoot": { ".validate": "newData.isBoolean()" },
            "nextShootEventId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "geofenceBypass": { ".validate": "newData.isBoolean()" },
            "geofenceNote": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
            "studioCheckIn": { ".validate": "newData.isBoolean()" },
            "studioCheckInBy": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180" },
            "studioCheckInNote": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
            "studioCheckout": { ".validate": "newData.isBoolean()" },
            "studioCheckoutBy": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180" },
            "studioCheckoutNote": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
            "checklistItems": {
              "$item": {
                ".validate": "newData.hasChildren(['t','done'])",
                "t": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
                "done": { ".validate": "newData.isBoolean()" },
                "$other": { ".validate": false }
              }
            },
            "checklistSections": {
              "$section": {
                ".validate": "newData.hasChildren(['name','items'])",
                "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
                "items": {
                  "$item": {
                    ".validate": "newData.hasChildren(['t','done'])",
                    "t": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
                    "done": { ".validate": "newData.isBoolean()" },
                    "$other": { ".validate": false }
                  }
                },
                "$other": { ".validate": false }
              }
            },
            "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "crewDayCosts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$weddingId": {
        "$date": {
          "$uid": {
            ".validate": "newData.hasChildren(['amount','currency','crewUid','nameSnapshot','roleSnapshot','updatedAt','updatedBy','source'])",
