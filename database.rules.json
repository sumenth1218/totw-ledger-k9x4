        "updatedById": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "updatedByName": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "updatedByRole": { ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'bride' || newData.val() === 'groom' || newData.val() === 'family' || newData.val() === 'planner')" },
