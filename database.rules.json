            "endTime": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))" },
            "venueName": { ".validate": "newData.isString() && newData.val().length <= 240" },
            "mapsUrl": { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "contactName": { ".validate": "newData.isString() && newData.val().length <= 120" },
