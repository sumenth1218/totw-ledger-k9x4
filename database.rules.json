        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name','role','updatedAt']) && (root.child('admins').child(auth.uid).val() === true || newData.hasChildren(['phone','email']))",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
