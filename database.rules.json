            "phone": { ".validate": "newData.isString() && newData.val().length >= 7 && newData.val().length <= 24" },
            "email": { ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 254" },
            "role": { ".validate": "newData.isString() && (newData.val() === 'bride' || newData.val() === 'groom' || newData.val() === 'family' || newData.val() === 'planner')" },
            "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "$other": { ".validate": false }
          }
        },
