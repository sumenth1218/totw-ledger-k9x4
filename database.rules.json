        ".validate": "newData.hasChildren(['client','eventType','eventDate','team','crewName','startTime','endTime','items','tickedCount','totalCount','submittedAt'])",
        "client": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
        "eventType": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "eventDate": { ".validate": "newData.isString() && newData.val().matches(/^20(26|27)-[0-1][0-9]-[0-3][0-9]$/)" },
