          ".validate": "newData.hasChildren()",
          "$eventId": {
            ".validate": "newData.hasChildren(['name','date','order'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "date": { ".validate": "newData.isString() && newData.val().matches(/^20(26|27)-[0-1][0-9]-[0-3][0-9]$/)" },
            "order": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100" },
            "studioOnly": { ".validate": "newData.isBoolean()" },
            "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "createdBy": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180" },
            "questions": {
              ".validate": "newData.hasChildren(['contact','brideReady','groomReady','notes'])",
              "contact": { ".validate": "newData.isBoolean()" },
              "brideReady": { ".validate": "newData.isBoolean()" },
              "groomReady": { ".validate": "newData.isBoolean()" },
              "notes": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
