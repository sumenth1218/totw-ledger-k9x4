      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$formId": {
        ".read": "root.child('clientForms').child($formId).exists()",
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (root.child('clientForms').child($formId).child('open').val() === true && root.child('clientForms').child($formId).child('locked').val() !== true && newData.exists())",
        "contact": {
          ".validate": "newData.hasChildren(['fullName','phone','email'])",
