        "crewName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "startTime": { ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)" },
        "endTime": { ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)" },
        "items": {
          ".validate": "newData.hasChildren()",
          "$item": {
            ".validate": "newData.hasChildren(['t','done'])",
            "t": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300" },
            "done": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "tickedCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "totalCount": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100" },
        "submittedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 86400000" },
        "eventId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
        "eventInstanceKey": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
        "crewEventId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "$other": { ".validate": false }
      }
    }
  }
}
